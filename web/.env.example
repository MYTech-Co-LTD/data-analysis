# Frontend public env template. Copy to .env.local for dev, or set on the
# web container for prod. Only NEXT_PUBLIC_* vars are exposed to the browser.

# --- InsForge / PostgREST gateway ---
NEXT_PUBLIC_INSFORGE_URL=http://localhost:7130
NEXT_PUBLIC_INSFORGE_ANON_KEY=replace-with-anon-key

# --- Casdoor SSO (Task 8: OIDC callback) ---
# Issuer base URL of the Casdoor instance (Task 3 docker-compose service).
NEXT_PUBLIC_CASDOOR_ISSUER=https://sso.shanhaiyiguo.com
# OAuth client_id of the Casdoor application created in Task 4.
# Placeholder — real value lands when Task 4 config is applied.
NEXT_PUBLIC_CASDOOR_CLIENT_ID=replace-with-casdoor-client-id
# Authorized redirect_uri registered in the Casdoor application. Must match
# the URL the browser used when redirecting to Casdoor. Fallback when unset is
# `${origin}/auth/callback` (origin from x-forwarded-proto/host).
NEXT_PUBLIC_CASDOOR_REDIRECT_URI=https://data.shanhaiyiguo.com/auth/callback

# --- 管理 API 鉴权（server-only）---
# requireAdmin 验签 access_token 的秘密，须与签发方（deno JWT_SECRET / PostgREST PGRST_JWT_SECRET）一致；
# 缺失时 /api/admin/** 全部 fail-close 500（防降级无验签放行）。本地 dev 用 deploy 默认 dev secret 即可。
JWT_SECRET=replace-with-jwt-secret

# --- WeCom direct OAuth (legacy fallback, until Casdoor fully接管) ---
# PC 扫码 (buildWecomQrLoginUrl) 与 H5 (buildWecomAuthUrl) 的旧路径，Casdoor
# 全量接管后可移除。未配置时对应入口返回空串自动隐藏。
NEXT_PUBLIC_WECOM_CORP_ID=
NEXT_PUBLIC_WECOM_AGENT_ID=
NEXT_PUBLIC_WECOM_REDIRECT_URI=
